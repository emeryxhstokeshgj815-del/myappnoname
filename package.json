{
  "name": "crux-c1-vocabulary",
  "version": "1.0.0",
  "private": true,
  "description": "Crux: offline C1 English vocabulary trainer for Russian speakers (single-file web app).",
  "type": "module",
  "scripts": {
    "data": "python3 scripts/build_dataset.py",
    "build": "node scripts/build_app.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "validate": "python3 scripts/validate_dataset.py",
    "test:a11y": "node tests/e2e/a11y.mjs",
    "screenshots": "node tests/e2e/screenshots.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "esbuild": "0.25.10",
    "playwright": "^1.56.1"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
